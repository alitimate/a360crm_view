<html xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:x="urn:schemas-microsoft-com:office:excel"
xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta http-equiv=Content-Type content="text/html; charset=utf-8">
<!--[if gte mso 9]><xml>
 <x:ExcelWorkbook>
  <x:ExcelWorksheets>
   <x:ExcelWorksheet>
    <x:Name>Dashboard</x:Name>
    <x:WorksheetOptions><x:Selected/></x:WorksheetOptions>
   </x:ExcelWorksheet>
  </x:ExcelWorksheets>
 </x:ExcelWorkbook>
</xml><![endif]-->
<style>
  body { font-family: Calibri, sans-serif; background-color: #f8fafc; padding: 20px; }
  .title { font-size: 18pt; font-weight: bold; background-color: #1e293b; color: #ffffff; text-align: center; height: 50px; vertical-align: middle; }
  .kpi-header { font-size: 9pt; font-weight: bold; color: #475569; background-color: #f1f5f9; text-align: center; }
  .kpi-val { font-size: 16pt; font-weight: bold; text-align: center; background-color: #ffffff; height: 35px; vertical-align: middle; }
  .section-title { font-size: 12pt; font-weight: bold; background-color: #334155; color: #ffffff; padding: 8px; }
  .th { font-weight: bold; background-color: #e2e8f0; color: #0f172a; text-align: left; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 20px; }
  td, th { border: 1px solid #cbd5e1; padding: 8px 12px; font-size: 10pt; }
</style>
</head>
<body>

  <table>
    <tr>
      <td colspan="7" class="title">🦅 CRM EXECUTIVE DASHBOARD</td>
    </tr>
    <tr><td colspan="7" style="border:none; height:10px;"></td></tr>
    <tr>
      <td class="kpi-header">TOTAL LEADS</td>
      <td class="kpi-header">CONVERTED</td>
      <td class="kpi-header">FOLLOW-UP</td>
      <td class="kpi-header">NOT INTERESTED</td>
      <td class="kpi-header">LINK SENT</td>
      <td class="kpi-header">UNANSWERED</td>
      <td class="kpi-header">CONV. RATE %</td>
    </tr>
    <tr>
      <td class="kpi-val">371</td>
      <td class="kpi-val" style="color:#059669;">10</td>
      <td class="kpi-val" style="color:#2563eb;">232</td>
      <td class="kpi-val" style="color:#dc2626;">93</td>
      <td class="kpi-val" style="color:#7c3aed;">14</td>
      <td class="kpi-val" style="color:#ea580c;">14</td>
      <td class="kpi-val" style="color:#059669;">2.7%</td>
    </tr>
  </table>

  <table>
    <tr>
      <td colspan="3" class="section-title">📊 Overall Status Breakdown</td>
      <td style="border:none; width:30px;"></td>
      <td colspan="5" class="section-title">👤 Sales Agent Performance</td>
    </tr>
    <tr>
      <td class="th">Status</td><td class="th">Lead Count</td><td class="th">Share %</td>
      <td style="border:none;"></td>
      <td class="th">Agent Name</td><td class="th">Total Leads</td><td class="th">Converted</td><td class="th">Not Interested</td><td class="th">Conv. Rate %</td>
    </tr>
    <tr>
      <td>Follow-up</td><td>232</td><td>62.5%</td>
      <td style="border:none;"></td>
      <td><strong>Nahan</strong></td><td>193</td><td>5</td><td>43</td><td>2.6%</td>
    </tr>
    <tr>
      <td>Not Interested</td><td>93</td><td>25.1%</td>
      <td style="border:none;"></td>
      <td><strong>Fateen</strong></td><td>121</td><td>5</td><td>45</td><td>4.1%</td>
    </tr>
    <tr>
      <td>Link Sent</td><td>14</td><td>3.8%</td>
      <td style="border:none;"></td>
      <td><strong>Mariyam</strong></td><td>54</td><td>0</td><td>3</td><td>0.0%</td>
    </tr>
    <tr>
      <td>Unanswered</td><td>14</td><td>3.8%</td>
      <td style="border:none;"></td>
      <td colspan="5" style="border:none;"></td>
    </tr>
    <tr>
      <td>Converted</td><td>10</td><td>2.7%</td>
      <td style="border:none;"></td>
      <td colspan="5" style="border:none;"></td>
    </tr>
    <tr style="font-weight:bold; background-color:#f1f5f9;">
      <td>Total Tracked</td><td>363</td><td>97.8%</td>
      <td style="border:none;"></td>
      <td colspan="5" style="border:none;"></td>
    </tr>
  </table>

  <table>
    <tr><td colspan="6" class="section-title">📅 Daily Lead Handling & Timeline Breakdown</td></tr>
    <tr>
      <td class="th">Date</td><td class="th">Total Leads</td><td class="th">Converted</td><td class="th">Not Interested</td><td class="th">Follow-up</td><td class="th">Link Sent / Unanswered</td>
    </tr>
    <tr><td>16/07/2026</td><td>31</td><td><strong style="color:#059669;">1</strong></td><td><span style="color:#dc2626;">18</span></td><td>11</td><td>1</td></tr>
    <tr><td>17/07/2026</td><td>18</td><td><strong style="color:#059669;">0</strong></td><td><span style="color:#dc2626;">2</span></td><td>15</td><td>1</td></tr>
    <tr><td>18/07/2026</td><td>21</td><td><strong style="color:#059669;">1</strong></td><td><span style="color:#dc2626;">0</span></td><td>19</td><td>1</td></tr>
    <tr><td>19/07/2026</td><td>33</td><td><strong style="color:#059669;">1</strong></td><td><span style="color:#dc2626;">5</span></td><td>26</td><td>1</td></tr>
    <tr><td>20/07/2026</td><td>21</td><td><strong style="color:#059669;">1</strong></td><td><span style="color:#dc2626;">3</span></td><td>17</td><td>0</td></tr>
    <tr><td>21/07/2026</td><td>23</td><td><strong style="color:#059669;">1</strong></td><td><span style="color:#dc2626;">6</span></td><td>16</td><td>0</td></tr>
    <tr><td>22/07/2026</td><td>24</td><td><strong style="color:#059669;">0</strong></td><td><span style="color:#dc2626;">8</span></td><td>15</td><td>1</td></tr>
    <tr><td>23/07/2026</td><td>17</td><td><strong style="color:#059669;">0</strong></td><td><span style="color:#dc2626;">4</span></td><td>13</td><td>0</td></tr>
    <tr><td>24/07/2026</td><td>10</td><td><strong style="color:#059669;">0</strong></td><td><span style="color:#dc2626;">2</span></td><td>8</td><td>0</td></tr>
    <tr><td>01/08/2026</td><td>53</td><td><strong style="color:#059669;">1</strong></td><td><span style="color:#dc2626;">27</span></td><td>16</td><td>7</td></tr>
    <tr><td>02/08/2026</td><td>17</td><td><strong style="color:#059669;">0</strong></td><td><span style="color:#dc2626;">5</span></td><td>9</td><td>3</td></tr>
    <tr><td>03/08/2026</td><td>20</td><td><strong style="color:#059669;">1</strong></td><td><span style="color:#dc2626;">1</span></td><td>14</td><td>4</td></tr>
    <tr><td>04/08/2026</td><td>26</td><td><strong style="color:#059669;">1</strong></td><td><span style="color:#dc2626;">7</span></td><td>15</td><td>3</td></tr>
    <tr><td>05/08/2026</td><td>36</td><td><strong style="color:#059669;">0</strong></td><td><span style="color:#dc2626;">4</span></td><td>30</td><td>2</td></tr>
    <tr><td>06/08/2026</td><td>20</td><td><strong style="color:#059669;">2</strong></td><td><span style="color:#dc2626;">1</span></td><td>8</td><td>4</td></tr>
  </table>

</body>
</html>
